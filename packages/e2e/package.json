{
  "name": "@rpgstudio/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright end-to-end tests: the built editor PWA, the exported game and the companion bridge in a real browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "test:debug": "playwright test --debug",
    "timings": "playwright test --workers=2 --reporter=list,./support/timingsReporter.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rpgstudio/companion-bridge": "workspace:*",
    "@rpgstudio/core": "workspace:*",
    "@types/node": "^22.20.5",
    "fflate": "^0.8.3"
  }
}
