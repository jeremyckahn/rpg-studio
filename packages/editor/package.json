{
  "name": "@rpgstudio/editor",
  "version": "0.1.0",
  "description": "React/MUI authoring workspace.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "dev": "vite --config vite.app.config.ts",
    "build:app": "vite build --config vite.app.config.ts",
    "preview": "vite preview --config vite.app.config.ts",
    "icons": "node --experimental-strip-types scripts/generate-icons.ts",
    "piskel:vendor": "node scripts/vendor-piskel.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-data-grid": "^9.14.0",
    "@pixi/tilemap": "^5.0.2",
    "@reduxjs/toolkit": "^2.13.0",
    "@rpgstudio/core": "workspace:*",
    "@rpgstudio/engine": "workspace:*",
    "fflate": "^0.8.3",
    "immer": "^11.1.21",
    "pixi.js": "^8.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@rpgstudio/companion-bridge": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1",
    "ws": "^8.22.0"
  }
}
