{
  "name": "@rpgstudio/engine",
  "version": "0.1.0",
  "description": "Headless-capable ECS game runtime with a PixiJS renderer.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@pixi/sound": "^6.0.1",
    "@pixi/tilemap": "^5.0.2",
    "@rpgstudio/core": "workspace:*",
    "miniplex": "^2.0.0",
    "pixi.js": "^8.22.0",
    "zod": "^4.6.5"
  }
}
