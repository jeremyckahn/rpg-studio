{
  "name": "rpg-studio-root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @rpgstudio/editor dev",
    "dev:editor": "pnpm --filter @rpgstudio/editor dev",
    "dev:companion": "pnpm --filter @rpgstudio/companion-bridge dev",
    "start": "pnpm run dev",
    "build": "pnpm -r run build",
    "build:app": "pnpm --filter @rpgstudio/editor build:app",
    "preview": "pnpm --filter @rpgstudio/editor preview",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-functional": "^6.5.1",
    "typescript": "~5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
