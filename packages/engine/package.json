{
  "name": "@rpgstudio/engine",
  "version": "0.1.0",
  "description": "Headless-capable ECS game runtime with a PixiJS renderer.",
  "license": "CC-BY-NC-SA-4.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./renderer": {
      "source": "./src/renderer/index.ts",
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer.js"
    },
    "./audio": {
      "source": "./src/audio/index.ts",
      "types": "./dist/audio/index.d.ts",
      "import": "./dist/audio.js"
    },
    "./player": {
      "source": "./src/player/index.ts",
      "types": "./dist/player/index.d.ts",
      "import": "./dist/player.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && vite build -c vite.player.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "build:player": "vite build -c vite.player.config.ts"
  },
  "dependencies": {
    "@pixi/sound": "^6.0.1",
    "@pixi/tilemap": "^5.0.2",
    "@rpgstudio/core": "workspace:*",
    "miniplex": "^2.0.0",
    "pixi.js": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "jsdom": "^30.1.2"
  }
}
