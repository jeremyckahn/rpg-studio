{
  "name": "@rpgstudio/companion-bridge",
  "version": "0.1.0",
  "description": "Local WebSocket companion server and reference AI agent runner.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "dev": "tsx --conditions=source src/cli.ts serve",
    "demo": "tsx --conditions=source src/cli.ts demo"
  },
  "dependencies": {
    "@rpgstudio/core": "workspace:*",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15"
  },
  "bin": {
    "rpgstudio-companion": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  }
}
